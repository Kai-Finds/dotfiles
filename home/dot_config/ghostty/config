# --- 🌟 General Settings ---
shell-integration = "zsh"
shell-integration-features = "cursor,sudo,title"
window-save-state = "default"
confirm-close-surface = false
quick-terminal-position = "top"
quick-terminal-autohide = true
window-inherit-working-directory = true
window-new-tab-position = "end"
resize-overlay = "never"

# --- 🎨 UI & Appearance ---
macos-non-native-fullscreen = true
macos-window-shadow = false
macos-titlebar-style = "transparent"
window-theme = "auto"
window-colorspace = "display-p3"
background-opacity = 0.85
background-blur-radius = 0
window-padding-x = 12
window-padding-y = 8
minimum-contrast = 1.0

# --- 🚀 Performance Optimizations ---
macos-option-as-alt = true
font-thicken = true
font-thicken-strength = 128
copy-on-select = "clipboard"
cursor-style = "block"
cursor-style-blink = false
focus-follows-mouse = true
mouse-hide-while-typing = true
click-repeat-interval = 300
window-vsync = true
alpha-blending = "linear-corrected"

# --- 🔤 Font & Rendering ---
font-family = "JetBrains Mono"
font-size = 20
font-feature = "+calt,+liga,+ss01"
font-synthetic-style = "bold,italic"
freetype-load-flags = "hinting,force-autohint"
adjust-cell-width = -1
adjust-cell-height = 2
font-codepoint-map = "U+E0A0-U+E0A3,U+E0B0-U+E0C8,U+E0CA,U+E0CC-U+E0D2,U+E0D4=JetBrainsMono Nerd Font"

# --- 🔒 Security ---
macos-auto-secure-input = true
macos-secure-input-indication = true
osc-color-report-format = "16-bit"

# --- 📋 Clipboard Handling ---
clipboard-write = "allow"
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

# --- 🎨 Theme & Navigation ---
theme = "Catppuccin Mocha"
keybind = super+t=new_tab
keybind = super+w=close_surface
keybind = super+shift+left=previous_tab
keybind = super+shift+right=next_tab
keybind = super+shift+d=new_split:down
keybind = super+d=new_split:right
keybind = super+k=clear_screen
keybind = super+shift+k=reset
keybind = super+equal=increase_font_size:1
keybind = super+minus=decrease_font_size:1
keybind = super+zero=reset_font_size
keybind = shift+enter=text:\x1b\r
